{
    "manifest_version": 3,
    "name": "CodeStreak",
    "version": "1.0.0",
    "description": "Track your DSA practice across platforms",
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://leetcode.com/*",
        "https://codeforces.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://geeksforgeeks.org/*",
        "https://practiceapiorigin.geeksforgeeks.org/*",
        "https://code-streak1.vercel.app/*",
        "https://codestreak-webapp.onrender.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/*",
                "https://*.geeksforgeeks.org/*",
                "https://geeksforgeeks.org/*"
            ],
            "js": ["inject.js"],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://leetcode.com/*",
                "https://*.geeksforgeeks.org/*",
                "https://geeksforgeeks.org/*"
            ],
            "js": ["content.js"]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/codestreak-favicon.png",
            "48": "icons/codestreak-favicon.png",
            "128": "icons/codestreak-favicon.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "externally_connectable": {
        "matches": [
            "https://code-streak1.vercel.app/*"
        ]
    }
}